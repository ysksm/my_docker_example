# --- ToolJet Server ---
TOOLJET_HOST=http://localhost
TOOLJET_HOST_PORT=8080
PORT=80
LOCKBOX_MASTER_KEY=replace_with_64_hex_chars_openssl_rand_hex_32
SECRET_KEY_BASE=replace_with_128_hex_chars_openssl_rand_hex_64
DEPLOYMENT_PLATFORM=docker
SERVE_CLIENT=true
ENABLE_TOOLJET_DB=true

# --- PostgreSQL (application database) ---
PG_HOST=postgres
PG_PORT=5432
PG_USER=tooljet
PG_PASS=tooljet_password
PG_DB=tooljet_production
PG_DB_OWNER=true

# --- ToolJet internal DB (PostgREST) ---
TOOLJET_DB_HOST=postgres
TOOLJET_DB_PORT=5432
TOOLJET_DB_USER=tooljet
TOOLJET_DB_PASS=tooljet_password
TOOLJET_DB=tooljet_db

# --- Email / Misc ---
CHECK_FOR_UPDATES=true
DISABLE_SIGNUPS=false
DISABLE_MULTI_WORKSPACE=false
